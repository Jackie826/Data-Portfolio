SELECT DISTINCT 
    p.person_nbr,
    p.person_id,
    pp.policy_nbr,
    p.sex,
    p.city,
    p.ethnicity,
    p.race,
    DATEDIFF(YY, CAST(p.date_of_birth AS DATE), GETDATE()) AS Age,
    lm.location_name,
    pe.discharge_date,
    pe.delete_ind

FROM patient_encounter pee
LEFT JOIN patient_program_enrollment pe ON pee.person_id = pe.person_id
LEFT JOIN person p ON pe.person_id = p.person_id
LEFT JOIN location_mstr lm ON pe.location_id = lm.location_id
LEFT JOIN person_payer pp ON p.person_id = pp.person_id

WHERE 
    DATEDIFF(DAY, CAST(pee.enc_timestamp AS DATE), GETDATE()) <= 365
    AND pe.location_id IN (
        '9D971E61-2B5A-4504-9016-7FD863790EE2',
        'A97BF74E-A822-468E-871E-197FD3C21314',
        '27DDCEA5-9048-4DA8-A1CE-35323403BD4E',
        'E6764687-D771-4420-9D04-92370E8BA245',
        'D8CC9783-E862-49A2-A82F-8983BAEA23FC',
        '58D75176-5578-4DCF-BDBE-AFFDCEB0D77E',
        '00D2BE2A-7960-44CA-A7EF-24AFC233A761'
    )
    AND pe.delete_ind = 'N'
    AND (
        pe.discharge_date IS NULL 
        OR LTRIM(RTRIM(pe.discharge_date)) = ''
    );
