-- Retrieve task details for select workgroups and patient encounters at specific locations
SELECT 
    td.task_id,
    CAST(td.create_timestamp AS DATE) AS Task_Create_Date,
    CAST(td.task_due_date AS DATE) AS Task_Due_Date,
    td.task_priority,
    CASE 
        WHEN td.task_completed = 0 THEN 'No' 
        ELSE 'Yes' 
    END AS Task_Completed,
    tm.workgroup_desc,
    tm.workgroup_name,
    td.task_subj,
    td.task_desc,
    td.pat_item_type,
    td.pat_item_desc

FROM user_todo_list td

-- Join to get the workgroup info for the user
LEFT JOIN task_workgroup_user_xref tw 
    ON tw.user_id = td.user_id

LEFT JOIN task_workgroup_mstr tm 
    ON tw.workgroup_id = tm.workgroup_id

-- Filter for relevant patient encounters
WHERE td.pat_enc_id IN (
    SELECT pe.enc_id
    FROM patient_encounter pe 
    WHERE pe.location_id IN (
        '9D971E61-2B5A-4504-9016-7FD863790EE2',
        'A97BF74E-A822-468E-871E-197FD3C21314',
        '27DDCEA5-9048-4DA8-A1CE-35323403BD4E',
        'E6764687-D771-4420-9D04-92370E8BA245',
        'D8CC9783-E862-49A2-A82F-8983BAEA23FC',
        '58D75176-5578-4DCF-BDBE-AFFDCEB0D77E',
        '00D2BE2A-7960-44CA-A7EF-24AFC233A761'
    )
)

-- Focus on specific workgroup descriptions
AND (
    tm.workgroup_desc ILIKE '%assistant%' 
    OR tm.workgroup_desc ILIKE '%front desk%'
)

-- Only include tasks with a due date from 2022 onwards
AND CAST(td.task_due_date AS DATE) >= '2022-01-01'

-- Sort by due date, most recent first
ORDER BY CAST(td.task_due_date AS DATE) DESC;
